# ---- @uniccodebot sozlamalari: shu qatorlarni loyiha ildizidagi .env ga qo'shing ----
# Token BotFather'dan. Hech qachon git'ga yozmang.
UNIC_BOT_TOKEN=

# Bo'sh bo'lsa asosiy DATABASE_URL ishlatiladi (jadvallar uc_ prefiksi bilan alohida turadi)
UNIC_DATABASE_URL=

# Botdan foydalanadiganlar (vergul bilan Telegram ID). Ikkalasi bo'sh bo'lsa bot HAMMAGA ochiq.
UNIC_ALLOWED_IDS=
UNIC_ADMIN_IDS=

UNIC_TYPE_CODE=CA
UNIC_START_SEQ=10000000
UNIC_TZ=Asia/Tashkent
UNIC_MAX_PER_REQUEST=100000

# Google Sheets (ixtiyoriy). Service account kaliti: fayl yo'li YOKI JSON matn.
GSHEET_ID=
GSHEET_WORKSHEET=Kodlar
GOOGLE_CREDENTIALS_FILE=/app/secrets/google.json
GOOGLE_CREDENTIALS_JSON=
GSHEET_SYNC_INTERVAL=15
GSHEET_BATCH=5000
